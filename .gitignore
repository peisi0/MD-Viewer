# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode build output / logs (regenerated by xcodebuild)
build/
DerivedData/
*.log
*.dSYM
*.ipa.tmp

# Xcode per-user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Local WorkBuddy workspace data (memory / session state, not source)
.workbuddy/
